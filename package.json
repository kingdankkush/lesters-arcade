{
  "name": "lesters-arcade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Retro Litecoin/Web3 arcade portal prototype for Lester's Arcade on LitVM.",
  "scripts": {
    "test": "node --test tests/*.test.mjs tests/projectile-pool.test.mjs",
    "check": "node scripts/syntax-check.mjs",
    "assets:slice": "python scripts/slice-hmh-generated-assets.py",
    "assets:lester": "python scripts/slice-lester-production-sprites.py",
    "assets:hmh:user": "python scripts/ingest-hard-money-heroes-user-assets.py",
    "assets:hmh:cabinet": "python scripts/ingest-hmh-cabinet-sprites.py",
    "assets:hmh:environment:inventory": "python scripts/inventory-hmh-environment-assets.py",
    "assets:hmh:environment": "python scripts/ingest-hmh-environment-assets.py",
    "assets:playlist": "python scripts/ingest-arcade-playlist-music.py",
    "assets:verify": "node scripts/verify-generated-assets.mjs",
    "assets:qa": "node scripts/sprite-qa.mjs",
    "assets:footprints": "node scripts/build-asset-footprints.mjs",
    "assets:atlas": "python scripts/generate-hmh-hd-sprite-atlas.py",
    "smoke:portal": "node scripts/smoke-portal-flow.mjs",
    "smoke:portal:interactions": "node scripts/smoke-portal-interactions.mjs",
    "design:audit": "node scripts/report-hmh-animation-coverage.mjs",
    "design:art-census": "node scripts/global-art-census.mjs",
    "design:art-repair": "node scripts/art-purge-repair.mjs",
    "design:hero-cert": "node scripts/hero-animation-certification.mjs",
    "design:roster": "node scripts/roster-coverage-report.mjs",
    "design:balance": "node scripts/write-hmh-balance-snapshot.mjs",
    "design:weekly": "node scripts/write-hmh-weekly-design-review.mjs",
    "design:animation-prompts": "node scripts/write-hmh-animation-production-requests.mjs",
    "contracts:check": "node scripts/contract-structure-check.mjs",
    "contracts:deploy": "node scripts/deploy-contracts.mjs",
    "build": "node build.mjs",
    "build:meta": "node build.mjs --metafile",
    "assets:optimize": "python scripts/optimize-assets.py",
    "verify:full": "npm run assets:verify && npm test && npm run check && npm run contracts:check && npm run design:audit && npm run design:art-census && npm run design:art-repair && npm run design:hero-cert && npm run design:balance && npm run smoke:portal && npm run smoke:portal:interactions && npm run design:animation-prompts && npm run design:weekly",
    "vercel:build": "npm run assets:verify && npm test && npm run check && npm run contracts:check",
    "serve": "python -m http.server 8791 --bind 127.0.0.1",
    "contracts:compile": "node scripts/compile-contracts.mjs",
    "assets:hmh:canonical": "python scripts/ingest-hmh-canonical-art.py",
    "assets:hmh:level1:queue": "node scripts/write-hmh-level-one-environment-asset-queue.mjs",
    "assets:hmh:level1:pixellab": "python scripts/pixellab-hmh-level1-asset-wave.py",
    "assets:hmh:level-env": "python scripts/ingest-hmh-level-environment.py",
    "assets:hmh:alpha-clean": "python scripts/clean-hmh-level-design-alpha.py",
    "assets:hmh:curated-level-kit": "python scripts/build-hmh-curated-level-kit.py",
    "repo:audit": "node scripts/repo-cleanup-audit.mjs",
    "repo:health": "node scripts/repo-health.mjs",
    "vault:status": "node scripts/vault-sync.mjs status"
  },
  "keywords": [
    "litecoin",
    "litvm",
    "web3",
    "arcade",
    "evm",
    "retro-gaming"
  ],
  "author": "Justin Pinter / Lester's Arcade concept",
  "license": "UNLICENSED",
  "devDependencies": {
    "esbuild": "^0.28.1",
    "solc": "^0.8.35"
  },
  "overrides": {
    "tmp": "^0.2.6"
  },
  "dependencies": {
    "ethers": "^6.17.0"
  }
}
