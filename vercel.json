{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run vercel:build",
  "outputDirectory": "apps/portal",
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/games/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/(profile|leaderboards|settings)",
      "destination": "/index.html"
    }
  ]
}
